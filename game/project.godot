; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Retro Chess"
config/version="0.5.3"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.04, 0.05, 0.11, 1)
boot_splash/image="res://assets/brand/logo.png"
boot_splash/fullsize=false
config/icon="res://assets/brand/icon.png"
config/windows_native_icon="res://assets/brand/icon.ico"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Audio="*res://src/audio/audio.gd"
Settings="*res://src/core/settings.gd"
Profiles="*res://src/core/profiles.gd"
Updater="*res://src/core/updater.gd"
Glove="*res://src/ui/glove_cursor.gd"
Pad="*res://src/ui/pad_cursor.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/resizable=true
window/size/borderless=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[importer_defaults]

texture={
"compress/high_quality": true,
"compress/mode": 2,
"mipmaps/generate": true
}

[rendering]

textures/canvas_textures/default_texture_filter=2
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
2d/snap/snap_2d_transforms_to_pixel=true

[internationalization]

locale/fallback="fr"
