[configuration]
entry_symbol = "retrochess_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
windows.x86_64 = "res://bin/libretrochess_ai.windows.x86_64.dll"
android.arm64 = "res://bin/libretrochess_ai.android.arm64-v8a.so"
linux.x86_64 = "res://bin/libretrochess_ai.linux.x86_64.so"
macos.x86_64 = "res://bin/libretrochess_ai.macos.x86_64.dylib"
macos.arm64 = "res://bin/libretrochess_ai.macos.arm64.dylib"
